# Stage 1: Build Environment (Gradle)
FROM eclipse-temurin:21-jdk-alpine AS build

WORKDIR /workspace/app

# Copy gradle wrapper and configurations
COPY gradlew .
COPY gradle gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .
COPY ferrox-java-core ferrox-java-core
COPY ferrox-java-showcase ferrox-java-showcase

# Build the showcase application without running tests
RUN ./gradlew :ferrox-java-showcase:bootJar -x test

# Stage 2: Runtime Environment
FROM eclipse-temurin:21-jre-alpine

# Add a non-root user
RUN addgroup -S ferrox && adduser -S ferrox -G ferrox
USER ferrox:ferrox

WORKDIR /app

# Copy the fat jar from build stage
COPY --from=build /workspace/app/ferrox-java-showcase/build/libs/*.jar app.jar

EXPOSE 8080

# Advanced JVM Tuning for High-Frequency Finance (OffHeap + ZGC)
ENTRYPOINT ["java", \
  "-XX:+UseZGC", \
  "-XX:ZAllocationSpikeTolerance=5", \
  "-Xms2G", "-Xmx2G", \
  "-XX:MaxDirectMemorySize=16G", \
  "-XX:+AlwaysPreTouch", \
  "-XX:+UseNUMA", \
  "-jar", "/app/app.jar"]
